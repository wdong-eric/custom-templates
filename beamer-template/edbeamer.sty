\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{edbeamer}[2026/10/02 Eric Dong's Beamer talk style]
% Extracted from scales-talk.tex and CIAE_EDtweak2.sty.
% Use with \documentclass{beamer}; keep talk metadata and assets in the .tex file.

% Typography and reusable slide tools. Beamer supplies amsmath, graphicx,
% xcolor and hyperref.
\RequirePackage[T1]{fontenc}
\usefonttheme[onlymath]{serif}
\RequirePackage{bm}
\RequirePackage{booktabs,multirow,calligra}
\RequirePackage{tikz}
\RequirePackage{appendixnumberbeamer}

% Compact author-year citations; each talk supplies its own \addbibresource.
\RequirePackage[
  backend=biber,
  style=authoryear,
  maxcitenames=1,
  mincitenames=1,
  maxbibnames=2,
  % Keep author lists short even for same-first-author/year citations.
  uniquelist=false,
  natbib=true,
  url=false,
  isbn=false,
]{biblatex}
\DefineBibliographyStrings{english}{andothers = {+}}
\DeclareDelimFormat{andothersdelim}{}

\mode<presentation>
\useoutertheme[footline=authorinstitutetitle,subsection=false]{smoothbars}
\useinnertheme{rounded}

%%==================== ====================
% Suppress navigation dots for selected frames (e.g. a table of contents).
% Call \miniframesoff before the frame and \miniframeson after it.
\let\beamer@writeslidentry@miniframeson=\beamer@writeslidentry
\def\beamer@writeslidentry@miniframesoff{%
  \expandafter\beamer@ifempty\expandafter{\beamer@framestartpage}{}%
  {\clearpage\beamer@notesactions}%
}
\newcommand*{\miniframeson}{\let\beamer@writeslidentry=\beamer@writeslidentry@miniframeson}
\newcommand*{\miniframesoff}{\let\beamer@writeslidentry=\beamer@writeslidentry@miniframesoff}

\newcommand{\frameofframes}{/}
\newcommand{\setframeofframes}[1]{\renewcommand{\frameofframes}{#1}}

%%==================== ====================
% One footer row: short author, short title, frame/total; no institute row.
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[colsep=1.5pt]{upper separation line foot}
  \end{beamercolorbox}
  %%==================== ====================
  %% remove author and institute in footline
  % \begin{beamercolorbox}[ht=2.0ex,dp=1.125ex,%
  %   leftskip=.3cm,rightskip=.3cm plus1fil]{author in head/foot}%
  %   \leavevmode{\usebeamerfont{author in head/foot}\insertshortauthor}%
  %   \hfill%
  %   {\usebeamerfont{institute in head/foot}\usebeamercolor[fg]{institute in head/foot}\insertshortinstitute}%
  % \end{beamercolorbox}%
  %%============================================
  \begin{beamercolorbox}[ht=2.0ex,dp=1.125ex,
    leftskip=.3cm,rightskip=.3cm plus1fil]{title in head/foot}%
    \leavevmode{\usebeamerfont{author in head/foot}\insertshortauthor}%
    \hfill%
    {\usebeamerfont{title in head/foot}\insertshorttitle}%
    \hfill%
    {\usebeamerfont{frame number}\usebeamercolor[fg]{frame number}%
    \insertframenumber~\frameofframes~\inserttotalframenumber}
  \end{beamercolorbox}%
  \begin{beamercolorbox}[colsep=1.5pt]{lower separation line foot}
  \end{beamercolorbox}
}

%%==================== ====================
% University of Melbourne blue.
\definecolor{uom}{HTML}{000F46}
\setbeamercolor{footline}{bg=uom}
\setbeamercolor{frametitle}{bg=uom,fg=white}
\setbeamercolor{title}{bg=uom}
\setbeamerfont{frametitle}{size=\large}

%%==================== ====================
% Biblatex entries without icons, and no navigation symbols.
\setbeamertemplate{bibliography item}{}
% turn off navigation symbols & adjust itemize subitem
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{itemize subitem}{\scriptsize$-$}
\setbeamertemplate{itemize subsubitem}{\scriptsize $\ast$}

\setbeamercolor{palette primary}{use=structure,fg=white,bg=structure.fg}
\setbeamercolor{palette secondary}{use=structure,fg=white,bg=structure.fg!75!black}
\setbeamercolor{palette tertiary}{use=structure,fg=white,bg=structure.fg!50!black}
\setbeamercolor{palette quaternary}{fg=white,bg=structure.fg!50!black}
\setbeamercolor{titlelike}{parent=palette primary}
\setbeamercolor{block title}{bg=uom,fg=white}
\setbeamercolor*{block title example}{use={normal text,example text},bg=white,fg=uom}
\setbeamercolor{fine separation line}{}
\setbeamercolor{item projected}{fg=white}
\setbeamercolor{palette sidebar primary}{use=normal text,fg=normal text.fg}
\setbeamercolor{palette sidebar quaternary}{use=structure,fg=structure.fg}
\setbeamercolor{palette sidebar secondary}{use=structure,fg=structure.fg}
\setbeamercolor{palette sidebar tertiary}{use=normal text,fg=normal text.fg}
\setbeamercolor{section in sidebar}{fg=brown}
\setbeamercolor{section in sidebar shaded}{fg=gray}
\setbeamercolor{separation line}{}
\setbeamercolor{sidebar}{bg=uom,parent=palette primary}
\setbeamercolor{structure}{fg=uom}
\setbeamercolor{subsection in sidebar}{fg=brown}
\setbeamercolor{subsection in sidebar shaded}{fg=gray}
\setbeamercolor{section in toc shaded}{fg=black!45}

